rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "vsshegur@gmail.com"; }
    function isManager() { return signedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Manager"); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin() || (isManager() && request.resource.data.role != "Admin"));
    }
    match /roleAssignments/{emailId} { allow read, write: if isAdmin(); }
    match /notifications/{id} {
      allow read, update: if signedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
    }
    match /settings/{docId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /inventory/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if signedIn();
      allow update: if isManager() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /temporaryLocks/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isManager() || (signedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
